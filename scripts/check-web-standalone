#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
web_root=${WEB_ROOT:-"$repo_root/web"}
[ -d "$web_root" ] || { echo "Web standalone audit passed: no web directory."; exit 0; }
bad=$(find "$web_root" -type f -name '*.mlpl' -exec grep -l '^[[:space:]]*include[[:space:]]' {} + || true)
[ -z "$bad" ] || { echo "web MLPL files must be standalone; include is unsupported by Editor > Load > Run:" >&2; echo "$bad" >&2; exit 1; }
echo "Web standalone audit passed."
