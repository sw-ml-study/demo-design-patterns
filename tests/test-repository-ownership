#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/design-pattern-ownership.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM

manifest="$tmp_dir/manifest.tsv"
paths="$tmp_dir/paths"
printf 'pattern\tscope\towner\tdisposition\tdestination\trationale\n' > "$manifest"
printf 'demos/patterns/*\tdemos\tdesign-patterns\tkeep\tdemo-design-patterns\ttest\n' >> "$manifest"
printf 'demos/patterns/strategy/example.mlpl\n' > "$paths"
BOUNDARY_MANIFEST="$manifest" BOUNDARY_PATHS="$paths" \
  "$repo_root/scripts/check-repository-ownership" >/dev/null

printf 'demos/algorithms/example.mlpl\n' > "$paths"
if BOUNDARY_MANIFEST="$manifest" BOUNDARY_PATHS="$paths" \
  "$repo_root/scripts/check-repository-ownership" >/dev/null 2>&1; then
  echo "expected algorithm material to fail ownership" >&2
  exit 1
fi

printf 'demos/*\tdemos\tshared\tkeep\tdemo-design-patterns\toverlap\n' >> "$manifest"
printf 'demos/patterns/strategy/example.mlpl\n' > "$paths"
if BOUNDARY_MANIFEST="$manifest" BOUNDARY_PATHS="$paths" \
  "$repo_root/scripts/check-repository-ownership" >/dev/null 2>&1; then
  echo "expected overlapping ownership rules to fail" >&2
  exit 1
fi

echo "Repository ownership regression tests passed."
